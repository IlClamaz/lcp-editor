; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot Main project"
run/main_scene="uid://cae17t6nis64d"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://icon.svg"

[autoload]

XRToolsUserSettings="*res://addons/godot-xr-tools/user_settings/user_settings.gd"
XRToolsRumbleManager="*res://addons/godot-xr-tools/rumble/rumble_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[editor_plugins]

enabled=PackedStringArray("res://addons/curator_dock/plugin.cfg", "res://addons/godot-xr-tools/plugin.cfg")

[rendering]

renderer/rendering_method="mobile"

[xr]

openxr/enabled=true
openxr/default_action_map="res://addons/living_platform_plugin/openxr/openxr_action_map.tres"
shaders/enabled=true
